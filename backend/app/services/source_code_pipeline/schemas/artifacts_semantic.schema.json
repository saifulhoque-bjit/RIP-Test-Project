{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifacts Semantic Schema v2 (Polyglot Edition)",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path"],
        "properties": {
          "id": { "type": "string" },
          "type": { 
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "$DYNAMIC_ENUM: registry.archetypes"
          },
          "path": { "type": "string" },
          "metrics": { "type": "object" },
          "structure": { "type": "object" },
          "signals": { "type": "object" },
          "references": { "type": "array" },
          "graph": { "type": "object" },
          "reuse": { "type": "object" },
          "semantic": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["feature_anchor", "supporting", "utility"]
              },
              "role_confidence": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "role_reason": {
                "type": ["string", "null"]
              },
              "likely_related": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "required": ["id", "confidence", "reason"],
                  "properties": {
                    "id": { "type": "string" },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "reason": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "likely_owner": {
                "type": ["object", "null"],
                "required": ["id", "confidence", "reason"],
                "properties": {
                  "id": { "type": "string" },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reason": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "reasoning": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}