{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RIP Target Architecture (Stage 6 output contract)",
  "description": "The emitted, frozen, codegen-consumable target architecture. Source-language-independent: describes the NEW system only. Produced by src/tools/architecture_synthesis.py.",
  "type": "object",
  "required": ["schema_version", "provenance", "target_platform", "architecture_style", "layers", "component_types"],
  "properties": {
    "schema_version": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["generated_at", "project_config_sha256", "seed_modules", "status"],
      "properties": {
        "generated_at": { "type": "string" },
        "project_id": { "type": "string" },
        "project_config_sha256": { "type": "string" },
        "seed_modules": { "type": "array", "items": { "type": "string" } },
        "prompt_version": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["draft", "frozen"] },
        "frozen_version": { "type": ["string", "null"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "target_platform": {
      "type": "object",
      "required": ["tech_allowlist"],
      "properties": {
        "frontend": { "type": "string" },
        "backend": { "type": "string" },
        "batch": { "type": "string" },
        "infrastructure": { "type": "string" },
        "database": { "type": "string" },
        "build": { "type": "string" },
        "runtime": { "type": "string" },
        "tech_allowlist": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "architecture_style": { "type": "string", "minLength": 1 },
    "topology": { "type": "string", "description": "modular-monolith (default) | microservices | ...", "minLength": 1 },
    "system_architecture": {
      "type": "object",
      "description": "Tier-B system/platform decisions (data ownership, identity issuance, config/secrets, deployment, migration, observability, testing, concurrency, audit).",
      "properties": {
        "data_ownership": { "type": "string" },
        "identity": { "type": "object" },
        "config_secrets": { "type": "object" },
        "deployment": { "type": "object" },
        "data_migration": { "type": "object" },
        "observability": { "type": "object" },
        "testing": { "type": "object" },
        "concurrency": { "type": "string" },
        "audit": { "type": ["boolean", "string"] }
      },
      "additionalProperties": true
    },
    "decision_ledger": {
      "type": "array",
      "description": "Every autonomous Tier-B decision, for review-by-exception.",
      "items": {
        "type": "object",
        "required": ["id", "area", "decision"],
        "properties": {
          "id": { "type": "string" },
          "area": { "type": "string" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "grounded_in": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string" },
          "reversibility": { "type": "string" },
          "escalated": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "responsibility": { "type": "string" },
          "allowed_dependencies": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "component_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "layer": { "type": "string" },
          "folder": { "type": "string" },
          "naming": { "type": "string" },
          "template_ref": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "cross_cutting": { "type": "array", "items": { "type": "object" } },
    "data_architecture": {
      "type": "object",
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "source_tables": { "type": "array", "items": { "type": "string" } },
              "owning_module": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "persistence": { "type": "string" },
        "transaction_boundaries": { "type": "string" }
      },
      "additionalProperties": true
    },
    "integration_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from_module", "to_module"],
        "properties": {
          "id": { "type": "string" },
          "from_module": { "type": "string" },
          "to_module": { "type": "string" },
          "kind": { "type": "string" },
          "interface": { "type": "string" },
          "weight": { "type": ["number", "integer"] }
        },
        "additionalProperties": true
      }
    },
    "nfrs": { "type": "array", "items": { "type": "object" } },
    "folder_structure": { "type": "object" },
    "naming_conventions": { "type": "object" },
    "codegen_directives": {
      "type": "object",
      "properties": {
        "element_to_component": { "type": "array", "items": { "type": "object" } },
        "dependency_rules": { "type": "array", "items": { "type": "string" } },
        "per_feature_output_layout": { "type": "string" }
      },
      "additionalProperties": true
    },
    "module_slicing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id"],
        "properties": {
          "module_id": { "type": "string" },
          "module_name": { "type": "string" },
          "execution_track": { "type": "string" },
          "is_shared": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "impact": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["arc_id"],
        "properties": {
          "arc_id": { "type": "string" },
          "derived_from": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
