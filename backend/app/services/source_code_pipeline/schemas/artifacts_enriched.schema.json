{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", 
          "type", 
          "path", 
          "metrics", 
          "structure", 
          "signals", 
          "references", 
          "graph", 
          "reuse",
          "paradigm_language",
          "edges",
          "graph_metrics"
        ],
        "properties": {
          "id": { "type": "string" },
          "file_name": { "type": "string" },
          "path": { "type": "string" },
          "file_hash": { 
            "type": "string",
            "description": "SHA-256 hash of the artifact to guarantee source code parity during downstream Stage 4 Spec Extraction."
          },
          "type": { 
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "$DYNAMIC_ENUM: registry.archetypes"
          },
          "paradigm_language": { 
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "$DYNAMIC_ENUM: registry.paradigm_language"
          },
          "loc": { "type": "integer" },
          "landmine_details": {
            "type": "object",
            "properties": {
              "flags": { 
                "type": "array",
                "description": "$DYNAMIC_ENUM: registry.risk_flags",
                "items": { 
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                } 
              },
              "severity": { "type": "string" },
              "normalized_score": { "type": "number" },
              "masked_regions": {
                "type": "array",
                "description": "Proprietary code blocks isolated before AST parsing to prevent structural cascading.",
                "items": {
                  "type": "object",
                  "required": ["category", "start", "end", "raw_text"],
                  "properties": {
                    "category": { "type": "string" },
                    "start": { "type": "integer", "description": "Starting byte index." },
                    "end": { "type": "integer", "description": "Ending byte index." },
                    "raw_text": { "type": "string" }
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "description": "Cross-module call extractions from the AST or regex engine.",
            "items": {
              "type": "object",
              "required": ["target", "type"],
              "properties": {
                "target": { "type": "string" },
                "type": { 
                  "type": "string",
                  "description": "The exact call paradigm (e.g., cobol_sql_ast, vb_call_regex, jcl_exec_regex)."
                },
                "line": { "type": "integer", "description": "Legacy fallback coordinate." },
                "line_start": { "type": "integer", "description": "AST Node starting line." },
                "line_end": { "type": "integer", "description": "AST Node ending line." },
                "column": { "type": "integer", "description": "AST Node starting column." },
                "resolved": {
                  "type": "boolean",
                  "description": "True if the target artifact exists in the workspace. False implies a missing or external dependency."
                }
              }
            }
          },
          "graph_metrics": {
            "type": "object",
            "description": "Topological routing and slicing metrics generated by the Graph Resolvers.",
            "required": ["incoming_edges", "outgoing_edges", "is_entry_point"],
            "properties": {
              "incoming_edges": { "type": "integer" },
              "outgoing_edges": { "type": "integer" },
              "is_entry_point": { "type": "boolean" },
              "traceability_chain": {
                "type": "array",
                "description": "The ordered path of execution from the Entry Point down to this artifact.",
                "items": { "type": "string" }
              }
            }
          },
          "metrics": {
            "type": "object",
            "required": ["lines_of_code", "script_lines"],
            "properties": {
              "lines_of_code": { "type": "integer" },
              "script_lines": { "type": "integer" },
              "ast_health_score": { "type": "number", "description": "Percentage of the file successfully parsed into the AST." },
              "total_nodes": { "type": "integer", "description": "Total AST nodes extracted." },
              "error_nodes": { "type": "integer", "description": "Number of Tree-sitter error nodes." }
            }
          },
          "structure": {
            "type": "object",
            "required": ["function_count", "event_count"],
            "properties": {
              "function_count": { "type": "integer" },
              "event_count": { "type": "integer" }
            }
          },
          "signals": {
            "type": "object",
            "description": "Dynamic boolean flags representing technical markers found by the language scanner.",
            "patternProperties": {
              "^[a-z_]+$": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "strength"],
              "properties": {
                "id": { "type": "string" },
                "strength": { "enum": ["strong", "weak"] }
              }
            }
          },
          "graph": {
            "type": "object",
            "required": ["calls", "called_by", "depth_from_anchor", "role"],
            "properties": {
              "calls": {
                "type": "array",
                "items": { "type": "string" }
              },
              "called_by": {
                "type": "array",
                "items": { "type": "string" }
              },
              "depth_from_anchor": {
                "type": ["integer", "null"]
              },
              "role": {
                "enum": ["entrypoint", "orchestrator", "helper", "isolated"]
              }
            }
          },
          "reuse": {
            "type": "object",
            "required": ["fan_in", "used_by_entrypoints", "is_shared_service"],
            "properties": {
              "fan_in": { "type": "integer" },
              "used_by_entrypoints": {
                "type": "array",
                "items": { "type": "string" }
              },
              "is_shared_service": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}