{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "mfus"
  ],
  "properties": {
    "mfus": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "complexity",
          "ai_confidence",
          "rationale",
          "execution_track",
          "traceability_chain"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "execution_track": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "$DYNAMIC_ENUM: registry.execution_tracks | Defines the runtime execution paradigm of the feature unit."
          },
          "artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "traceability_chain": {
            "type": "array",
            "description": "Mathematical proof of topological grouping, showing the shared execution path.",
            "items": {
              "type": "string"
            }
          },
          "complexity": {
            "type": "string",
            "enum": [
              "Simple",
              "Medium",
              "Complex",
              "Critical"
            ]
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$",
              "description": "$DYNAMIC_ENUM: registry.risk_flags"
            }
          },
          "ai_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          },
          "review": {
            "type": "object",
            "properties": {
              "reviewed_by": {
                "type": "string"
              },
              "review_notes": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected",
                  "needs_revision"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "additionalProperties": false
      },
      "_comment_minItems": "minItems=0 is intentional: infrastructure-only modules (Win32 wrappers, global variable holders, utility-only modules) legitimately produce zero business MFUs. The orphan_sweeper creates SYS-* coverage buckets downstream. Changed from 1 to 0 to prevent crash on valid empty-mfu responses."
    }
  }
}