# Environment — Development
# Copy to .env and fill in real values.  Never commit .env — it is git-ignored.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
SECRET_KEY=change_me_at_least_32_chars_long
CORS_ORIGINS=["http://localhost:5173","https://rip.bjitgroup.com"]
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# When running via Docker Compose, POSTGRES_HOST is overridden to "postgres"
# by the x-app-env block.  Keep localhost for running the app outside Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rip_dev
POSTGRES_USER=rip_user
POSTGRES_PASSWORD=change_me 
# Schema bootstrap toggle. Keep false for migration-first startup.
# Set true only for local bootstrap scenarios.
DB_AUTO_CREATE=false

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Docker Compose overrides NEO4J_URI to bolt://neo4j:7687.
# Keep the localhost URL for local development outside Docker.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Docker Compose overrides these to redis://redis:6379/{db}.
# Keep localhost-based URLs for local development outside Docker.
# DB 0 — general cache / WebSocket pub-sub
# DB 1 — Celery broker
# DB 2 — Celery result backend
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Leave empty (or set 0) to disable result-backend socket read timeout and
# avoid idle timeout noise on managed Redis networks.
CELERY_RESULT_SOCKET_TIMEOUT=
# Leave empty (or set 0) to disable broker socket read timeout and avoid
# idle reconnect loops on managed Redis networks.
CELERY_BROKER_SOCKET_TIMEOUT=
CELERY_BROKER_SOCKET_CONNECT_TIMEOUT=30
CELERY_BROKER_HEALTH_CHECK_INTERVAL=30

# ── AWS Credentials ───────────────────────────────────────────────────────────
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty on AWS infrastructure
# (ECS task role / instance profile is used automatically).
# Set explicitly for local development and CI only.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me

# ── AWS Cognito ───────────────────────────────────────────────────────────────
AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXX
AWS_COGNITO_CLIENT_ID=change_me
AWS_COGNITO_CLIENT_SECRET=change_me

# ── AWS SQS ───────────────────────────────────────────────────────────────────
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/rip-events
AWS_SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/000000000000/rip-events-dlq

# ── AWS SES ───────────────────────────────────────────────────────────────────
# Verified sending identity (email or domain) used for invitation emails.
AWS_SES_SENDER_EMAIL=rashedul.alam@bjitgroup.com

# ── Invitations ────────────────────────────────────────────────────────────────
# Base URL of the frontend app; invite-accept links are built from this.
FRONTEND_BASE_URL=https://rip.bjitgroup.com
INVITATION_EXPIRY_DAYS=7

# ── Super Admin bootstrap (MVP) ────────────────────────────────────────────────
# Idempotent — safe to leave set across restarts/redeploys. Leave email/password
# empty to disable seeding (e.g. after retiring the bootstrap account).
SEED_SUPER_ADMIN_ENABLED=true
SUPER_ADMIN_EMAIL=change_me@example.com
SUPER_ADMIN_PASSWORD=change_me_strong_password
SUPER_ADMIN_NAME=Super Admin

# ── S3 Source Storage ─────────────────────────────────────────────────────────
AWS_S3_SOURCES_BUCKET=rip-development-s3-static
AWS_S3_PRESIGNED_URL_EXPIRY=3600
S3_DOWNLOAD_CHUNK_SIZE_MB=5
SOURCE_MAX_FILE_SIZE_MB=500
SOURCE_LINK_MAX_FILE_SIZE_MB=500
SOURCE_BULK_MAX_FILES=20

# ── LlamaParse ────────────────────────────────────────────────────────────────
LLAMA_CLOUD_API_KEY=change_me

# ── OmniParser ────────────────────────────────────────────────────────────────
OMNIPARSER_BASE_URL=https://omniparser-rip.bjitgroup.com/
OMNIPARSER_TIMEOUT_SECONDS=300
OMNIPARSER_MAX_INPUT_LENGTH=8000

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# Supply the key(s) for whichever provider(s) your agents are configured to use.
# Agents not using a provider can leave that key empty.
OPENAI_API_KEY=change_me
ANTHROPIC_API_KEY=change_me
GOOGLE_API_KEY=change_me
DEEPSEEK_API_KEY=change_me

# LiteLLM ships its model cost/context-window map bundled locally; setting this
# skips the startup fetch from GitHub, avoiding a network call/failure point.
LITELLM_LOCAL_MODEL_COST_MAP=True

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Format: "{count}/{period}" — period: second | minute | hour | day
# Tighten these values (e.g. 5/minute) for production deployments.
RATE_LIMIT_AUTH_REGISTER=10/minute
RATE_LIMIT_AUTH_CONFIRM=10/minute
RATE_LIMIT_AUTH_LOGIN=20/minute
RATE_LIMIT_AUTH_REFRESH=30/minute

SOURCE_LOCAL_DOWNLOAD_DIR=temp/sources

# ── Jira Integration ──────────────────────────────────────────────────────────
# REQUIRED for the Jira sync feature. Fernet key used to encrypt Jira API tokens
# at rest. Saving a Jira integration fails if this is empty or invalid.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JIRA_ENCRYPTION_KEY=change_me_44_char_fernet_key

# ── Tenant LLM Providers ────────────────────────────────────────────────────────
# REQUIRED to store/test tenant LLM provider API keys. Fernet key used to encrypt
# them at rest — kept separate from JIRA_ENCRYPTION_KEY so each secret domain can
# be rotated independently. Generate the same way as JIRA_ENCRYPTION_KEY.
LLM_ENCRYPTION_KEY=change_me_44_char_fernet_key

# ── TAP Integration ────────────────────────────────────────────────────────────
# TAP connection details — base URL, API key, client id — are configured PER
# PROJECT in RIP's project settings and stored encrypted. They are NOT env
# vars: they are per-tenant credentials, and a deployment-wide fallback would
# let one project push its requirements into TAP under another's identity.
# Only the three settings below are deployment-level.
#
# Fernet key encrypting each project's TAP API key at rest. Generate one per
# environment, and NEVER change it once keys are stored — rotating it makes
# every stored key undecryptable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TAP_ENCRYPTION_KEY=change_me_44_char_fernet_key
# Shared secret with TAP: TAP must send this exact value as the
# X-TAP-Signature header on its inbound pull + ack calls. Agree one value per
# environment with the TAP team and set it on BOTH sides. Unset makes the two
# inbound callbacks refuse everything (503); mismatched makes them 403, and a
# sync then stages but silently never completes.
TAP_ACK_SECRET=change_me_shared_secret
# Public address TAP reaches RIP on (scheme + host, no trailing slash), used
# to build the pull_url TAP fetches staged data from. Must be routable from
# TAP's network — not an internal Docker hostname. Leave empty for local-only
# testing: staging and notifying still work, only that display field is omitted.
RIP_PUBLIC_BASE_URL=https://rip.example.com

LITELLM_LOCAL_MODEL_COST_MAP=True